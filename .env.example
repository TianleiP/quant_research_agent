# SQLite remains the default when these checkpoint settings are omitted.
QUANT_AGENT_CHECKPOINT_BACKEND=postgres
QUANT_AGENT_CHECKPOINT_POSTGRES_URI=postgresql://quant_agent:replace-me@127.0.0.1:55432/quant_agent?sslmode=disable&connect_timeout=5

# Local Docker Compose PostgreSQL settings. Replace the example password in .env.
POSTGRES_USER=quant_agent
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=quant_agent
POSTGRES_PORT=55432

# Optional integration-test database. This should point to a disposable database.
QUANT_AGENT_TEST_POSTGRES_URI=postgresql://quant_agent:replace-me@127.0.0.1:55432/quant_agent?sslmode=disable&connect_timeout=5
